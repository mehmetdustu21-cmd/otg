# Durable PostgreSQL connection string from your database provider (for example, a pooled connection URL).
DATABASE_URL=

# Admin login. Change the default username if desired; set the password only in Vercel Environment Variables.
ADMIN_USERNAME=mehmetdustu
ADMIN_PASSWORD=

# Use a random value of at least 32 characters for signed admin sessions.
SESSION_SECRET=

# Set this in Vercel to the configured Vercel Cron secret; never commit the value.
CRON_SECRET=

# Set to the final public origin, e.g. https://www.example.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=
