# Neon pooled PostgreSQL connection string. In Neon, copy the pooled connection string
# from the Connect dialog and keep sslmode=require in the URL when it is provided.
DATABASE_URL=

# Optional fallbacks for Vercel/Neon integrations. DATABASE_URL takes priority.
NEON_DATABASE_URL=
POSTGRES_URL=

# Random private value used to hash IP + browser data for approximate unique-visitor counts.
ANALYTICS_HASH_SALT=

# Demo admin login. Replace these values before any real/public deployment.
ADMIN_USERNAME=mehmetdustu
ADMIN_PASSWORD=1

# Use a random value of at least 32 characters for signed admin sessions.
SESSION_SECRET=

# Set this in Vercel to the configured Vercel Cron secret; never commit the value.
CRON_SECRET=

# Set to the final public origin, e.g. https://www.example.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=
